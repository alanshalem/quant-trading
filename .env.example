# Copy to .env and fill in as needed. .env is gitignored.

# Override PyTorch wheel index (default: CPU). Example GPU CUDA 12.1:
# QUANT_TORCH_INDEX=https://download.pytorch.org/whl/cu121

# Optional exchange API keys — ONLY needed if you plan to submit live orders
# via ccxt. Public market data (OHLCV, trades) does NOT require keys.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Log level for library code (default: INFO)
# QUANT_LOG_LEVEL=DEBUG
